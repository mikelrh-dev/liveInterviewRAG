# InterviewTTS Environment Variables
# Copy to .env and fill in values.
#
# Every variable the backend reads is declared here, and nothing else is.
# tests/test_config_surface.py enforces both directions by reading backend/config.py
# rather than a list, so a key added there without a line here fails the suite.
#
# The bind address (host and port) is NOT here and cannot be. It is a command-line
# argument owned by the unit file -- deployment/interviewtts.service:24 for the
# deployed service, RUNBOOK.md:18 for local development -- so that the API is only
# reachable through the local reverse proxy. A HOST= line in this file used to sit
# here reading 0.0.0.0, which config.py never honoured: an operator who set it
# believed they had configured an exposure the process did not have.

# OpenRouter API (required as fallback)
OPENROUTER_API_KEY=your-api-key-here
LLM_MODEL=openrouter/owl-alpha
LLM_TEMPERATURE=0.7
# 200 is the value backend/config.py defaults to, and it is the one to change here.
# The example used to say 500 while the code said 200, so copying this file and
# leaving the variable alone produced a different configuration from not copying it.
LLM_MAX_TOKENS=200

# Google AI API (optional — primary provider when set)
# Get your API key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-ai-key-here
# GOOGLE_MODEL=gemini-3.1-flash-lite

# Whisper settings
# Default `small` for better Spanish accuracy; override to `tiny` for ~2x faster, lower-accuracy CPU transcription.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# CTranslate2 inter-op threads, and the parallelism between concurrent
# transcriptions. faster-whisper passes this straight through as
# `inter_threads=num_workers` when it builds its single Whisper model, and
# documents it as: "When transcribe() is called from multiple Python threads,
# having multiple workers enables true parallelism when running the model
# (concurrent calls to self.model.generate() will run in parallel). This can
# improve the global throughput at the cost of increased memory usage."
#
# It is NOT one copy of the model per worker -- there is a single model object,
# built once no matter what this is set to. The parallelism and the memory cost
# are inside CTranslate2. (`WHISPER_CPU_THREADS` / `intra_threads` is the
# parameter that is about cores.)
#
# Unset meant faster-whisper's default of 1, which serialises concurrent
# transcriptions. 4 is the core count of the deployed box (ARM64, 4 cores) and
# the service is single-process, so it is "every core, no more": past the core
# count this buys oversubscription, not throughput. On a bigger box use
# min(cores, 4).
WHISPER_NUM_WORKERS=4

# TTS voice
TTS_VOICE=es-ES-AlvaroNeural

# CORS origins (comma-separated for production)
# Each origin is stripped of surrounding whitespace, so " a , b " and "a,b" are the
# same list. An unstripped origin never matches the Origin header a browser sends.
CORS_ORIGINS=http://localhost:8000,https://tudominio.com

# RAG settings
# Multilingual on purpose: `wiki/` and the questions are Spanish, and an English
# embedder charges a language gap on every paraphrase. Measured 2026-09-29 on the
# 49 labelled questions, shipped configuration: recall@3 0.8163, recall@1
# 0.7347. backend/config.py carries the same measurement plus the superseded one
# it replaced; tests/real_wiki.py::MEASURED_FULL is what enforces it.
# Changing this value invalidates the embedding cache (the model name is part
# of the cache identity), so the next start recomputes from scratch.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=50
# Where the pre-computed embedding vectors live. Written at startup, read on the
# next one, and validated against the model, chunking and corpus hash before use.
RAG_CACHE_DIR=backend/.rag_cache

# Cross-encoder re-ranking of the top-k. It PERMUTES the RAG_TOP_K slots the
# pipeline already chose, so it cannot change which pages are served — only their
# order. Measured on the 49 labelled questions at top_k=3: gold@1 36 -> 40 (net
# +4, seven promotions and three demotions), and recall@3 unchanged at 44/49.
# Cost: ~90 ms of CPU per query on top of a ~24 ms retrieval, and ~470 MB of
# download plus ~1 GB of RSS, loaded once per process.
#
# Set this to false to go back to the dense+BM25 order. It is a decision and not a
# fault: /api/health reports `rerank_mode: "disabled"` and stays "ok" while it is
# off. The gain and the cost are both measured in backend/services/rerank.py.
RERANK_ENABLED=true
# Multilingual, 0.1B params, Apache 2.0, and it loads through the
# sentence-transformers this project already depends on — no new dependency.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Maximum length of one candidate answer, in seconds. This is the ONE limit on a
# recording and it is enforced: the page fetches it from GET /api/config on load
# and stops the recorder itself when it is reached, uploading what it has
# instead of growing until the upload ceiling rejects it. 60 is comfortably under
# what MAX_AUDIO_SIZE (5 MiB) would allow at the recorder's bitrate (~5.4 min),
# so the byte gate never fires first. Lowering it to 30 will cut candidates off
# mid-answer; raising it much past 150 starts to risk the byte ceiling.
MAX_AUDIO_DURATION=60

# Session TTL — hours an idle conversation is kept before eviction. Floor 0.1;
# anything below is rejected and the default used.
SESSION_TTL_HOURS=2

# Periodic sweep interval in minutes (eviction, audio pruning, report expiry).
# Floor 1, and the floor is load-bearing: the value is multiplied by 60 and slept
# on, and asyncio.sleep returns immediately for anything at or below 0, so 0 would
# not mean "sweep constantly" but a sweep that never yields.
AUDIO_CLEANUP_INTERVAL_MIN=30

# Conversation persistence (Cap-2) — SQLite write-through store
# Set PERSISTENCE_ENABLED=false to fall back to in-memory-only sessions.
PERSISTENCE_ENABLED=true
DB_PATH=data/interviewtts.db

# Report retention — days before generated interview transcripts are pruned
REPORT_RETENTION_DAYS=30
# Where those Markdown transcripts are written. Listed in the unit's ReadWritePaths,
# so the directory has to exist before the service starts.
REPORTS_DIR=reports
