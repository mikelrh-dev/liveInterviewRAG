# InterviewTTS Environment Variables
# Copy to .env and fill in values

# Owl API (required)
OWL_API_KEY=your-api-key-here
OWL_API_URL=https://api.owl.ai/v1/chat/completions
OWL_MODEL=gpt-3.5-turbo

# Whisper settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS voice
TTS_VOICE=en-US-GuyNeural

# RAG settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Server
HOST=0.0.0.0
PORT=8000

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
MAX_AUDIO_DURATION=30
