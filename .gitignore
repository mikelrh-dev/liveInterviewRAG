# RAG embedding cache
.rag_cache/

# Node dependencies. package-lock.json stays tracked on purpose: it is what makes
# `npm ci` reproducible, and an unpinned install is not. The tree itself is a build
# artifact -- 1234 files and 12.6 MB that git collapses into one untracked entry, so
# an unreviewed `git add -A` stages all of it in a single step and buries whatever
# change was actually being made.
node_modules/

# Local env overrides
*.local

# Freebuff/Codebuff MCP config (local, not shared)
.agents/mcp.json
# Local Pi runtime state
.atl/

# Candidate content (personal data; generated from wiki/ by scripts/wiki/compile.py)
/candidate/

# Private wiki source (backed up to a separate PRIVATE repo, never this one)
/wiki/

# Wiki audit reports (local working docs, not project content)
AUDITORIA-*.md

# Conversation-database backups. The live database is covered by *.db above, but a
# timestamped backup ends in .bak-<stamp> and matches nothing, so a plain `git add -A`
# staged 1.68 MB of transcribed interview history. These are the most sensitive thing
# this project produces and they are never project content.
data/*.db.bak-*

# Local clone of the original, kept side by side for comparison. It is a nested git
# repository: git records it as a gitlink, which is neither useful nor reviewable here.
original/

# CodeGraph local index and daemon state. codegraph.db alone is 12.5 MB of derived
# data -- it is a cache of the source, not part of the source.
.codegraph/

# Local measurement artifacts written by the audit's regression-injection harness.
.measure/

# Obsidian knowledge vault about this project. Its manifest references the private
# wiki throughout, so its provenance cannot be shown to be independent of it. Local
# only until that is established.
wikiDocs/
